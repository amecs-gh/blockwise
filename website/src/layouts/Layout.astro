---
// Every page: the head (language, search and link-preview tags, links to the
// other language), the menu bar and the footer. No scripts.
import '../styles/site.css'
import '../styles/ui.css'
import { type Lang, type PageKey, LANGS, PAGES, href, site, tr, DOWNLOADS } from '../i18n'

interface Props {
	lang: Lang
	page: PageKey | '404'
	title?: string
	description?: string
	/** Structured data for search engines (home page only) */
	ld?: object
}
const { lang, page, title, description, ld } = Astro.props
const t = tr(lang)
const base = site.url.replace(/\/+$/, '')
const other: Lang = lang === 'en' ? 'it' : 'en'
const key = page === '404' ? '' : page
const fullTitle = title ? `${title} · Blockwise` : site.title[lang]
const desc = description ?? site.description[lang]
const abs = (p: string) => (base ? base + p : p)
const og = abs('/img/og.png')
---
<!doctype html>
<html lang={lang}>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'">
	<script is:inline src="/js/site.js"></script>
	<meta name="referrer" content="no-referrer">
	<title>{fullTitle}</title>
	<meta name="description" content={desc}>
	{page === '404' ? <meta name="robots" content="noindex"> : <meta name="robots" content="index, follow">}
	<meta name="theme-color" content="#f6f5fb" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#14121d" media="(prefers-color-scheme: dark)">
	<meta name="color-scheme" content="light dark">
	{page !== '404' && base && <link rel="canonical" href={abs(href(lang, key))}>}
	{page !== '404' && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(href(l, key))}>)}
	{page !== '404' && <link rel="alternate" hreflang="x-default" href={abs(href('en', key))}>}
	<link rel="icon" href="/logo.svg" type="image/svg+xml">
	<link rel="apple-touch-icon" href="/img/icon-180.png">
	<link rel="preload" href="/fonts/Poppins-Regular.woff" as="font" type="font/woff" crossorigin>
	<link rel="preload" href="/fonts/Poppins-Bold.woff" as="font" type="font/woff" crossorigin>
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="Blockwise">
	<meta property="og:title" content={fullTitle}>
	<meta property="og:description" content={desc}>
	<meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'}>
	<meta property="og:locale:alternate" content={lang === 'it' ? 'en_US' : 'it_IT'}>
	{base && <meta property="og:url" content={abs(href(lang, key))}>}
	<meta property="og:image" content={og}>
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta property="og:image:alt" content={site.title[lang]}>
	<meta name="twitter:card" content="summary_large_image">
	{ld && <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />}
</head>
<body>
	<a class="skip" href="#main">{t({ en: 'Skip to content', it: 'Vai al contenuto' })}</a>
	<header class="bar">
		<div class="bar__in">
			<a class="brand" href={href(lang, '')}><img src="/logo.svg" alt="" width="34" height="34"><span class="brand__name">Blockwise</span></a>
			<nav class="tabs" id="menu" aria-label={t({ en: 'Site', it: 'Sito' })}>
				{PAGES.filter((p) => p.key !== '' && p.key !== 'download/').map((p) => (
					<a href={href(lang, p.key)} aria-current={p.key === page ? 'page' : undefined}>{t(p.label)}</a>
				))}
				<a class="tabs__lang" href={href(other, key)} hreflang={other} lang={other}>
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
					{other === 'it' ? 'Italiano' : 'English'}
				</a>
			</nav>
			<div class="bar__end">
				<button type="button" class="icon-btn" id="theme" hidden
					data-to-light={t({ en: 'Switch to the light theme', it: 'Passa al tema chiaro' })}
					data-to-dark={t({ en: 'Switch to the dark theme', it: 'Passa al tema scuro' })}
					data-to-auto={t({ en: 'Use your system’s theme', it: 'Usa il tema del sistema' })}>
					<svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17z" fill="currentColor" stroke="none" /></svg>
					<svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" /></svg>
					<svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>
				</button>
				<a class="btn btn--small" href={href(lang, 'download/')} aria-current={page === 'download/' ? 'page' : undefined}>{t({ en: 'Download', it: 'Scarica' })}</a>
				<button type="button" class="icon-btn menu-btn" id="menu-button" hidden aria-controls="menu" aria-expanded="false" aria-label={t({ en: 'Menu', it: 'Menu' })}>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path class="m-open" d="M4 7h16M4 12h16M4 17h16" /><path class="m-close" d="M6 6l12 12M18 6L6 18" /></svg>
				</button>
			</div>
		</div>
	</header>

	<main id="main">
		<slot />
	</main>

	<footer class="foot">
		<div class="foot__in">
			<div class="foot__brand">
				<a class="brand" href={href(lang, '')}><img src="/logo.svg" alt="" width="28" height="28">Blockwise</a>
				<p>{t({ en: 'Plan your week in blocks. Free and open source, with no accounts, no tracking and no ads.', it: 'Pianifica la settimana a blocchi. Gratis e open source, senza account, tracciamento o pubblicità.' })}</p>
			</div>
			<nav aria-label={t({ en: 'More', it: 'Altro' })}>
				<h2>{t({ en: 'Blockwise', it: 'Blockwise' })}</h2>
				{PAGES.map((p) => <a href={href(lang, p.key)}>{t(p.label)}</a>)}
				<a href="/app/">{t({ en: 'Open in your browser', it: 'Apri nel browser' })}</a>
			</nav>
			<nav aria-label={t({ en: 'Project', it: 'Progetto' })}>
				<h2>{t({ en: 'Project', it: 'Progetto' })}</h2>
				<a href={DOWNLOADS.releases}>{t({ en: 'Releases on GitHub', it: 'Versioni su GitHub' })}</a>
				<a href={DOWNLOADS.license}>{t({ en: 'License (AGPL-3.0)', it: 'Licenza (AGPL-3.0)' })}</a>
				<a href={href(lang, 'download/') + '#changelog'}>{t({ en: 'What’s new', it: 'Novità' })}</a>
				<a href={href(lang, 'privacy/') + '#report'}>{t({ en: 'Report a security problem', it: 'Segnala un problema di sicurezza' })}</a>
			</nav>
		</div>
		<p class="foot__note">© 2026 Blockwise</p>
	</footer>
</body>
</html>
