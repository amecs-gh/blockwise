<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Electron's JavaScript engine needs these two under the hardened runtime -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Ad-hoc signed builds have no Team ID, so Electron's own frameworks would
	     fail library validation and the app would not start. Code injection
	     through DYLD_* variables and debuggers stays blocked by the hardened runtime. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Apple Calendar (macOS still asks you once) -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
